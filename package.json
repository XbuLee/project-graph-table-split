  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": ["extprg", "project-graph", "table", "text-nodes"],
  "scripts": {
    "check": "node --check extension.js && node --check package.mjs && node --check test.mjs",
    "test": "node --test test.mjs",
    "package": "node package.mjs"
  },
  "devDependencies": {
    "@msgpack/msgpack": "3.1.3",
    "@zip.js/zip.js": "2.8.26",
    "comlink": "4.4.2"
  }
}
